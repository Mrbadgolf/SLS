# Operations Dashboard - Environment Configuration
# Copy this file to .env and customize for your setup

# ============================================
# EXTERNAL SERVICE URLS
# ============================================
# URLs for quick links on the dashboard
OLIVETIN_URL=https://olivetin.geaux-tv.com
NETDATA_URL=https://netdata.geaux-tv.com
PORTAINER_URL=https://portainer.geaux-tv.com

# ============================================
# TRAEFIK CONFIGURATION
# ============================================
# Path to Traefik access logs (for streaming activity)
TRAEFIK_LOG_DIR=/var/log/traefik

# ============================================
# COMPOSE CONFIGURATION
# ============================================
# Base directory containing Docker Compose files
COMPOSE_DIR=/opt/stremio-stack

# ============================================
# BACKUP CONFIGURATION
# ============================================
# Restic backup repository location
BACKUP_DIR=/opt/backups

# Restic repository password (REQUIRED for backup/restore)
# Generate a strong password and keep it safe!
RESTIC_PASSWORD=your-secure-password-here

# ============================================
# STREAMING DETECTION
# ============================================
# URL patterns to match for streaming activity (comma-separated)
# STREAMING_PATTERNS=/stream,/play,/video,/hls,/dash,/manifest,/stremio

# Time window in minutes for "active" stream counting
# ACTIVE_WINDOW_MINUTES=5

# ============================================
# DISK MONITORING
# ============================================
# Paths to monitor for disk usage (comma-separated)
# MONITOR_DISKS=/,/opt
